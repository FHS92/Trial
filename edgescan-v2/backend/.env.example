# ============================================================
# EdgeScan v2 Backend — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ----------------------------------------------------------
# Data provider
# ----------------------------------------------------------
# yfinance              Dev-only — scrapes Yahoo Finance. NOT for production.
# edgar                 Free SEC EDGAR XBRL API. Fundamentals only (no prices).
# edgar+alpha_vantage   Recommended for production. EDGAR fundamentals + AV prices.
# alpha_vantage         Alpha Vantage only (fundamentals + prices from AV).
DATA_PROVIDER_PRIMARY=yfinance

# API key for the primary provider (required for alpha_vantage / edgar+alpha_vantage)
DATA_PROVIDER_PRIMARY_KEY=

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# Leave unset to use SQLite (edgescan_v2.db in the backend directory).
# For PostgreSQL:  postgresql://user:password@host:5432/edgescan_v2
DATABASE_URL=

# ----------------------------------------------------------
# Anthropic — AI thesis generation (optional)
# ----------------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------------
# Auth — shared with Next.js frontend (Phase 3)
# ----------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ----------------------------------------------------------
# Stripe — billing (Phase 5)
# ----------------------------------------------------------
# Use sk_test_... for dev, sk_live_... for production.
# IMPORTANT: using sk_live_... will block yfinance provider at startup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------
# Scan tuning
# ----------------------------------------------------------
SCAN_BATCH_SIZE=50
BATCH_DELAY_SECONDS=0.15

# ----------------------------------------------------------
# Admin bootstrap
# ----------------------------------------------------------
# Comma-separated email addresses that get admin access via
# the stub auth (before Phase 3 real auth is wired in).
ADMIN_EMAILS=
