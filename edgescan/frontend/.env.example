# EdgeScan Frontend — Environment Variables (v2)
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Auth (Auth.js v5) ─────────────────────────────────────────────────────
AUTH_SECRET=                         # Must match backend AUTH_SECRET (min 32 chars)
AUTH_GOOGLE_ID=                      # Google OAuth Client ID
AUTH_GOOGLE_SECRET=                  # Google OAuth Client Secret
NEXTAUTH_URL=http://localhost:3000   # Full URL of the Next.js app

# ─── Backend API ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000  # FastAPI backend URL

# ─── Stripe ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # pk_test_... (test) or pk_live_... (production)
STRIPE_PRICE_PRO_MONTHLY=            # price_... Stripe price ID for $15/mo
STRIPE_PRICE_PRO_ANNUAL=             # price_... Stripe price ID for $144/yr

# ─── Analytics ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_KEY=           # PostHog or equivalent public key

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Must match backend setting
