# EdgeScan Backend — Environment Variables
# Copy to .env and fill in values

# Anthropic API key (required for AI thesis generation)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string (leave unset to use local SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/edgescan

# Secret for POST /api/scan/trigger
SCAN_SECRET=edgescan-local-secret

# Batch tuning (optional)
SCAN_BATCH_SIZE=50
BATCH_DELAY_SECONDS=2.0

# Frontend URL (for CORS in production)
NEXT_PUBLIC_API_URL=http://localhost:8000
