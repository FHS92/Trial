# EdgeScan Backend — Environment Variables (v2)
# Copy to .env and fill in real values. Never commit .env.

# ─── Auth (shared with frontend) ───────────────────────────────────────────
AUTH_SECRET=                        # Secret for Auth.js v5 JWT signing (min 32 chars)

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=                        # postgresql://user:password@host:5432/edgescan
                                     # Leave unset to use local SQLite (dev only)

# ─── Market Data Provider(s)  ← chosen in Phase 1 ─────────────────────────
# Valid values: polygon | tiingo | fmp | eodhd | yfinance (dev only)
DATA_PROVIDER_PRIMARY=polygon        # Primary licensed provider
DATA_PROVIDER_PRIMARY_KEY=           # API key for primary provider

DATA_PROVIDER_FALLBACK=tiingo        # Secondary/fallback provider
DATA_PROVIDER_FALLBACK_KEY=          # API key for fallback provider

# yfinance is never used in production — dev/local only
# To use yfinance locally: DATA_PROVIDER_PRIMARY=yfinance

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                   # sk_test_... (test) or sk_live_... (production)
STRIPE_WEBHOOK_SECRET=               # whsec_... from Stripe Dashboard → Webhooks

# ─── Anthropic (Why Now + Chat) ────────────────────────────────────────────
ANTHROPIC_API_KEY=                   # sk-ant-...

# ─── Email (transactional) — e.g. Resend ───────────────────────────────────
EMAIL_API_KEY=                       # Resend or equivalent
EMAIL_FROM=                          # noreply@yourdomain.com

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Public URL (used in emails, OG cards)
ADMIN_EMAILS=                        # Comma-separated emails granted is_admin on first login

# ─── Scan tuning ───────────────────────────────────────────────────────────
SCAN_SECRET=edgescan-local-secret    # Auth header for POST /api/scan/trigger
SCAN_BATCH_SIZE=50                   # Tickers per batch
BATCH_DELAY_SECONDS=2.0              # Sleep between batches (seconds)

# ─── Rate limits (optional overrides) ──────────────────────────────────────
AI_CHAT_DAILY_LIMIT=50               # Max AI Chat messages per user per day (Pro)
SCAN_NOW_HOURLY_LIMIT=1              # Max on-demand scans per user per hour

# ─── Legacy (v1 — will be removed) ────────────────────────────────────────
# LEADERBOARD_HIDDEN_PROFILES=Fouad
